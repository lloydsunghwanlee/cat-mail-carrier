PORT=8080
# 랭킹 DB(game.db)를 둘 폴더. 비우면 메모리에만 저장되어 재시작 때 사라집니다.
DATA_DIR=./data
# 점수 등록 토큰 서명용 비밀값. 아무 긴 무작위 문자열. 바꾸면 진행 중인 판의 등록만 실패합니다.
RUN_SECRET=change-me-to-a-long-random-string
# 관리자 API(/api/admin/*) 키. 비우면 관리자 API가 꺼집니다.
ADMIN_KEY=
# API를 불러도 되는 웹 주소(쉼표로 구분). 게임과 API가 같은 서버면 그대로 두세요.
ALLOWED_ORIGINS=*
# 프록시(Render, Fly, Nginx) 뒤에 있으면 1 → X-Forwarded-For 로 접속자 구분
TRUST_PROXY=0
